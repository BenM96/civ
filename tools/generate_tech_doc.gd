extends SceneTree
## Writes TECHS.md: every tech in the game (TechList), tier by tier, with
## what it does and what it needs. Run it from the project folder whenever
## the techs change:
##
##   Godot_v4.7.2-stable_win64_console.exe --headless --path . -s tools/generate_tech_doc.gd
##
## It reads the real tech list, so the file always matches the game.

const OUT := "res://TECHS.md"


func _initialize() -> void:
	TechList.check()
	var lines: PackedStringArray = []
	lines.append("# Technologies")
	lines.append("")
	lines.append("_Generated by `tools/generate_tech_doc.gd` from the tech files in `scripts/techs/tier_N/` - don't edit by hand; run the script again instead._")
	lines.append("")
	lines.append("Techs are researched with Electrum from **Research (R)**. Each game deals every tech out to %d trees, %d per tree from each tier, tier 1 first; which tree a tech lands on is shuffled per game (the same for every colony). A tree is researched in order, and the Nth tech on a tree costs N Electrum, so each tier's heading below shows what its techs cost. Researching a tech only unlocks or raises things - it never builds anything." % [
		TechTrees.TREE_COUNT, TechTrees.TECHS_PER_TREE_TIER])
	lines.append("")
	lines.append("%d techs in %d tiers." % [TechList.all().size(), TechList.tier_count()])
	for tier in range(1, TechList.tier_count() + 1):
		var low := (tier - 1) * TechTrees.TECHS_PER_TREE_TIER + 1
		var high := tier * TechTrees.TECHS_PER_TREE_TIER
		lines.append("")
		lines.append("## Tier %d (%d-%d Electrum)" % [tier, low, high])
		lines.append("")
		lines.append("| Tech | What it does | Also needs |")
		lines.append("|---|---|---|")
		for tech in TechList.in_tier(tier):
			var needs := "-"
			if tech.requires != "":
				var before := TechList.get_tech(tech.requires)
				needs = "%s (tier %d)" % [before.display_name, before.tier] if before else tech.requires
			lines.append("| **%s** | %s | %s |" % [tech.display_name, tech.get_effect_text(), needs])
	lines.append("")
	var file := FileAccess.open(OUT, FileAccess.WRITE)
	if file == null:
		push_error("Couldn't write %s" % OUT)
		quit(1)
		return
	file.store_string("\n".join(lines))
	file.close()
	print("Wrote %s (%d techs)" % [ProjectSettings.globalize_path(OUT), TechList.all().size()])
	quit()

